# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

DB_HOST=localhost
DB_PORT=3306
DB_USER=motorix_app
DB_PASSWORD=
DB_NAME=motorix
# Base usada solo por las pruebas automatizadas (debe terminar en _test)
DB_NAME_TEST=motorix_test

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
